# ==============================================================================
# Bengaluru Traffic AI — Safe Environment Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit .env with real credentials or production connection strings!
# ==============================================================================

# Database Configuration (Optional - MongoDB fails gracefully to console if offline)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=bengaluru_traffic

# Flask Backend Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
PORT=5000

# Frontend Configuration (Used when running Vite locally)
VITE_API_URL=http://localhost:5000

# Junction Reference Coordinates (Optional — defaults to Silk Board: 12.9176 N, 77.6238 E)
JUNCTION_NAME="Silk Board, Bengaluru"
JUNCTION_LAT=12.9176
JUNCTION_LON=77.6238
